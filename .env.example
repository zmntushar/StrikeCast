# StrikeCast configuration — copy to .env and edit as needed. Every value is optional.
# No API keys are required: all data sources are free and open.

# Identify yourself to NOAA/NWS and OpenStreetMap (their usage policies ask for a contact)
STRIKECAST_CONTACT=https://github.com/your-name/strikecast

# Storage (SQLite by default; PostgreSQL works too: postgresql+psycopg://user:pass@host/db)
STRIKECAST_DATABASE_URL=sqlite:///data/strikecast.db

STRIKECAST_DEFAULT_TIMEZONE=America/New_York
STRIKECAST_LOG_LEVEL=INFO
STRIKECAST_FORECAST_DAYS=7

# HTTP behavior
STRIKECAST_HTTP_TIMEOUT_S=25
STRIKECAST_HTTP_MAX_RETRIES=3
STRIKECAST_HTTP_MAX_CONCURRENCY=8
STRIKECAST_CACHE_ENABLED=true

# Cache lifetimes in seconds (matched to how often each provider updates)
STRIKECAST_TTL_OPENMETEO_FORECAST=3600
STRIKECAST_TTL_OPENMETEO_MARINE=3600
STRIKECAST_TTL_OPENMETEO_HISTORY=604800
STRIKECAST_TTL_NWS_POINTS=2592000
STRIKECAST_TTL_NWS_HOURLY=3600
STRIKECAST_TTL_NWS_ALERTS=600
STRIKECAST_TTL_COOPS_PREDICTIONS=86400
STRIKECAST_TTL_COOPS_OBSERVATIONS=1800
STRIKECAST_TTL_NDBC_REALTIME=1800
STRIKECAST_TTL_BATHYMETRY=7776000
STRIKECAST_TTL_GEOCODE=7776000

# Background refresh of your favorite spots while the API server runs
STRIKECAST_SCHEDULER_ENABLED=true
STRIKECAST_SCHEDULER_INTERVAL_MIN=60
